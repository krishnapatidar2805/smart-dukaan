# ---- Rename this file to .env and fill in your own values ----

# Django
DJANGO_SECRET_KEY=change-this-to-a-random-string
DJANGO_DEBUG=True

# Database (MySQL). Set USE_SQLITE=True to skip MySQL setup and test quickly.
USE_SQLITE=False
DB_NAME=smart_dukaan
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# AI Assistant (optional) - get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# WhatsApp via Twilio (optional) - get free sandbox creds from https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
